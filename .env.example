# ============================================================
# CodePilot RAG — Environment Variables
# Copy this file to .env and fill in your values.
#
# The values below are the LOCAL (docker-compose) defaults.
# For the Render deployment, do NOT use this file — those values are
# set in the Render dashboard / render.yaml. Deviations are noted inline.
# ============================================================

# --- LLM Provider ---
LLM_PROVIDER=gemini                    # gemini | openai
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key    # optional, only if using openai

# --- Embedding Model ---
EMBEDDING_MODEL=models/gemini-embedding-2   # Google embedding model

# EMBEDDING_MODEL=text-embedding-3-small   # OpenAI alternative

# --- Gemini Model ---
GEMINI_MODEL=models/gemini-2.5-flash


# --- OpenAI Model (fallback) ---
OPENAI_MODEL=gpt-4o

# --- ChromaDB ---
# Local: the chromadb container from docker-compose.
# Render: leave CHROMA_HOST/CHROMA_PORT UNSET so vectorstore.py falls back
#         to the embedded PersistentClient, and point the persist dir at
#         the mounted disk (CHROMA_PERSIST_DIR=/app/data/chroma).
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=/app/chroma_data

# --- MongoDB ---
# Local: the mongodb container from docker-compose.
# Render: a MongoDB Atlas SRV string — Render has no managed MongoDB.
#   MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# The database name is applied separately via MONGODB_DB_NAME, so the
# SRV string does not need a database path.
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=copilot_rag

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins.
# Render: must include the Vercel production URL, e.g.
#   CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Optional regex for origins that can't be listed up front — Vercel preview
# deployments get a new random hostname on every build. Leave empty to disable.
# Matched with re.fullmatch, so it must describe the ENTIRE origin.
# Keep it narrow: allow_credentials is enabled, so a pattern like
# https://.*\.vercel\.app would expose this API to any Vercel-hosted site.
#   CORS_ORIGIN_REGEX=https://frontend-[a-z0-9-]+-yourteam-projects\.vercel\.app
CORS_ORIGIN_REGEX=

# --- File Storage ---
# Render: point at the persistent disk (UPLOAD_DIR=/app/data/uploads),
# otherwise uploaded ZIPs are lost on restart and downloads/patch-apply 404.
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# --- GitHub (optional, for private repo cloning) ---
GITHUB_TOKEN=your-github-token

# --- Security ---
SECRET_KEY=your-secret-key-change-in-production

# API key for mutating endpoints (ingest, delete, patch apply).
# LEAVE EMPTY to disable auth entirely — that is the right setting for local
# development. SET IT on any internet-reachable deployment, otherwise anyone
# can ingest repositories, delete indexes, and burn your LLM quota.
# Clients send it as the  X-API-Key  header.
API_KEY=

# Require the API key for /chat as well. Off by default so a public demo stays
# usable (chat is still covered by the per-IP rate limiter). Turn on if
# anonymous traffic is draining LLM quota.
PROTECT_CHAT=false

# /repos/local reads an arbitrary directory from the SERVER filesystem.
# Fine locally; a directory-disclosure primitive when hosted. Set to false in
# production — GitHub URL and ZIP upload still work.
ALLOW_LOCAL_INGEST=true

# Optional: confine /repos/local to a single root directory. Paths are resolved
# before the check, so '..' traversal cannot escape it. Empty = no confinement.
LOCAL_INGEST_ROOT=

# --- Authentication (GitHub OAuth) ---
# Master switch. false = the original public behaviour: no sign-in, every
# repository visible to everyone. true = a GitHub session is required and each
# user only sees their own repositories.
AUTH_REQUIRED=true

# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be exactly:
#     <API_BASE_URL>/auth/github/callback
# e.g. https://codepilot-snj4.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# "repo" is what allows listing and cloning PRIVATE repositories.
# Narrow to "read:user user:email" for public-only access.
GITHUB_OAUTH_SCOPES=read:user user:email repo

# Where the browser is sent after a successful callback. Must be the deployed
# web app, NOT the API. The session token arrives in the URL fragment.
FRONTEND_URL=http://localhost:3000

# Signs session JWTs. Falls back to SECRET_KEY when empty. Rotating this
# invalidates every session AND makes stored GitHub tokens undecryptable,
# so users must reconnect GitHub.
JWT_SECRET=
JWT_EXPIRY_HOURS=168

# --- Retrieval quality ---
# Minimum relevance score (0..1, higher is better) for a chunk to be used as
# grounding context. If NOTHING clears this bar the agent refuses to answer
# rather than inventing one.
#
# Measured with gemini-embedding-2 over a spread of REAL questions:
#   on-topic  0.3525 - 0.5125   (weakest genuine question was 0.3525)
#   off-topic 0.2164 - 0.2360
# An earlier 0.35 was set from the extremes only and sat inside the genuine
# band, so ordinary questions were refused. Re-measure if you change the
# embedding model or the chunk size.
RETRIEVAL_MIN_SCORE=0.25

# Secondary relative filter: after the absolute floor, drop chunks scoring
# below this fraction of the best match for the query. Never causes a refusal,
# because the top chunk always survives. 0 disables it.
RETRIEVAL_RELATIVE_CUTOFF=0.6

# Number of chunks pulled per query, and max distinct files cited back.
RETRIEVAL_K=8
MAX_CITATIONS=6
